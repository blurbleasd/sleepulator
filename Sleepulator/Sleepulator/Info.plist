<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Deep link used by the home-screen "Resume sleep mix" widget (sleepulator://resume). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.sleepulator.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sleepulator</string>
			</array>
		</dict>
	</array>
	<!-- MusicKit: shown when the app first requests Apple Music access (Focus-mode mixing).
	     MusicKit itself is enabled server-side on the App ID's App Services (Developer portal) —
	     it is NOT a code-signed entitlement, so there is no .entitlements key to add. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Sleepulator uses Apple Music so you can layer your own music with focus sounds in Focus mode.</string>
	<!-- ATS justification (for App Review): users add arbitrary podcast RSS feeds, and a
	     large share of episode enclosures are still served over cleartext http://. This is
	     scoped to MEDIA only (AVPlayer audio) — NOT NSAllowsArbitraryLoads — so app API/web
	     traffic still requires HTTPS. Host-allowlisting isn't feasible for user-supplied feeds. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInMedia</key>
		<true/>
	</dict>
</dict>
</plist>
